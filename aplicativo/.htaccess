# App da Nova Igreja Batista em /app (contas reais, banco MySQL). No servidor: public_html/app.
DirectoryIndex index.html
Options -Indexes
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
# Compressão: o celular baixa os arquivos de texto (JS, CSS, HTML, JSON) bem menores.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  # Segurança: o app não abre dentro de outro site (moldura) e só carrega código e conteúdo de endereços conhecidos.
  # Ao usar um serviço novo (outro site de vídeo, imagens de outro endereço), acrescente o endereço aqui.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://novaigrejabatista.com.br https://www.novaigrejabatista.com.br; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://novaigrejabatista.com.br https://www.novaigrejabatista.com.br; frame-src https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  # Página, service worker e manifesto sempre conferidos, para a versão nova chegar.
  <FilesMatch "^(index\.html|conheca\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
