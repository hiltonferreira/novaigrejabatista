# BEGIN NIB ROTAS LEGADAS
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^public_html/(index\.html)?$ / [R=302,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(camp-sbgp1-nov26|public_html/next/camp-sbgp1-nov26)/?(index\.html)?$ /next/camp-sbgp1-nov26/ [R=302,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(camp-sbgp1-nov26|public_html/next/camp-sbgp1-nov26)/inscricao\.html$ /next/camp-sbgp1-nov26/inscricao.html [R=302,L]
</IfModule>
# END NIB ROTAS LEGADAS


